* text=auto

*.sh text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.sql text eol=lf

*.ps1 text eol=crlf

# Conformance fixture binaries.
#
# `* text=auto` above would let git normalize line endings inside these, which
# on a Windows checkout silently rewrites bytes that happen to look like CRLF.
# Every weights_sha256 and tf_logits_sha256 in meta.json would then fail to
# reproduce — and it would fail only on some platforms, which is the worst way
# to discover it.
*.safetensors binary
*.npz         binary
*.gguf        binary

# The DSML golden is compared byte-for-byte and upstream records LF bytes.
tests/fixtures/dsml/encoding/tests/*.txt text eol=lf
